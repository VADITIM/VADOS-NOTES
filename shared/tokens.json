{
  "version": 1,
  "units": {
    "length": "millimetre",
    "duration": "millisecond"
  },
  "page": {
    "cell_width": 210,
    "cell_height": 297,
    "grid_spacing": 5,
    "paper": "#EFEEE9",
    "guide": "#D9D7CF",
    "cell_boundary": "#B3B0A5",
    "outside": "#181818",
    "default_style": "dark",
    "neutral_ink_chroma": 0.12,
    "styles": {
      "dark": { "paper": "#0A0A0A", "guide": "#1D1D1D", "cell_boundary": "#3A3A3A" },
      "light": { "paper": "#EFEEE9", "guide": "#D9D7CF", "cell_boundary": "#B3B0A5" }
    }
  },
  "palette": {
    "ground": "#181818",
    "panel": "#121212D9",
    "panel_solid": "#121212",
    "sunken_deep": "#0E0E0E",
    "sunken": "#1C1C1C",
    "raised": "#232323",
    "border": "#262626",
    "border_strong": "#2C2C2C",
    "border_control": "#3A3A3A",
    "border_hover": "#5A5A5A",
    "pressed_wash": "#FFFFFF1F",
    "text_primary": "#FFFFFFDE",
    "text_bright": "#F0F0F0",
    "text_body": "#D8D8D8",
    "text_muted": "#9A9A9A",
    "text_label": "#8A8A8A",
    "text_icon": "#6A6A6A",
    "text_faint": "#4A4A4A",
    "accent": "#FFDD1B"
  },
  "semantic": {
    "destructive": "#FF6B6B",
    "destructive_hard": "#DC143C",
    "create": "#5BFD5B",
    "navigation": "#4D8BFF",
    "view": "#9A9A9A",
    "edit": "#F0F0F0",
    "import": "#F09B3A"
  },
  "tools": {
    "pen": {
      "layer": "ink",
      "width": 0.5,
      "width_range": [0.2, 2.0],
      "width_presets": [0.35, 0.6, 1.2],
      "opacity": 1.0,
      "colors": ["#1A1A1A", "#0040FF", "#DC143C", "#0BC993"]
    },
    "pencil": {
      "layer": "ink",
      "width": 0.35,
      "opacity": 0.78,
      "colors": ["#4A4A4A", "#1A1A1A", "#3664FC", "#B0306B"]
    },
    "marker": {
      "layer": "marker",
      "width": 5.0,
      "width_range": [2.0, 12.0],
      "width_presets": [3.0, 5.0, 8.0],
      "opacity": 0.38,
      "colors": ["#FFDD1B", "#5BFD5B", "#2EE6FF", "#FF2E88"]
    },
    "eraser": {
      "radius": 2.0,
      "radius_range": [0.5, 12.0],
      "modes": ["stroke", "area"]
    }
  },
  "ink": {
    "sample_spacing_points": 1.0,
    "smoothing_points": 2.6,
    "simplify_points": 0.12,
    "straighten_tolerance_points": 8
  },
  "text": {
    "font": "Mono",
    "font_size": 4.2,
    "line_height": 1.35,
    "box_width": 80,
    "color": "#1A1A1A"
  },
  "motion": {
    "curves": {
      "back_out": [0.34, 1.56, 0.64, 1.0],
      "back_in": [0.36, 0.0, 0.66, -0.56],
      "power_two_out": [0.5, 1.0, 0.89, 1.0],
      "power_two_in": [0.11, 0.0, 0.5, 0.0],
      "power_three_in_out": [0.65, 0.0, 0.35, 1.0]
    },
    "durations": {
      "press": 80,
      "release": 220,
      "state": 220,
      "section_enter": 260,
      "section_enter_delay": 60,
      "section_leave": 120,
      "overlay_enter": 240,
      "overlay_leave": 140,
      "sweep_grow": 420,
      "sweep_retract": 500,
      "menu_hold": 450,
      "nav_slide": 240,
      "nav_trail": 60,
      "nav_carry_hold": 1000,
      "stroke_straighten_hold": 1000,
      "stroke_straighten_snap": 160,
      "undo": 2500
    }
  },
  "sync": {
    "idle_seconds": 5,
    "max_age_seconds": 60,
    "backoff_seconds": [1, 2, 4, 8, 16, 30]
  },
  "menus": {
    "columns": 3,
    "page": [
      { "slot": 0, "action": "previous_page", "role": "navigation" },
      { "slot": 1, "action": "next_page", "role": "navigation" },
      { "slot": 2, "action": "new_page", "role": "create" },
      { "slot": 3, "action": "expand_columns", "role": "create" },
      { "slot": 4, "action": "expand_rows", "role": "create" },
      { "slot": 5, "action": "import", "role": "import" },
      { "slot": 6, "action": "toggle_guides", "role": "view" },
      { "slot": 7, "action": "fit_page", "role": "view" },
      { "slot": 8, "action": "delete_page", "role": "destructive" }
    ],
    "notebook": [
      { "slot": 0, "action": "rename", "role": "edit" },
      { "slot": 1, "action": "appearance", "role": "edit" },
      { "slot": 2, "action": "move", "role": "navigation" },
      { "slot": 3, "action": "delete_notebook", "role": "destructive" }
    ],
    "page_tile": [
      { "slot": 0, "action": "rename", "role": "edit" },
      { "slot": 1, "action": "appearance", "role": "edit" },
      { "slot": 2, "action": "move", "role": "navigation" },
      { "slot": 3, "action": "delete_page", "role": "destructive" }
    ]
  },
  "folders": {
    "default_color": "#FFDD1B",
    "default_icon": "folder",
    "note_icon": "note",
    "colors": ["#FFDD1B", "#F09B3A", "#FF6B6B", "#FF2E88", "#B98CFF", "#4D8BFF", "#2EE6FF", "#5BFD5B", "#F0F0F0"],
    "icons": ["folder", "note", "book", "star", "heart", "bolt", "flag", "bookmark", "pin", "bulb", "code", "music", "home"]
  }
}
